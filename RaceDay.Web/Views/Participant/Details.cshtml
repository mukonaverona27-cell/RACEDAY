@model RaceDay.Web.Models.EventViewModels
@{
    var categories = (List<RaceDay.Web.Models.EventCategoryViewModels>)ViewBag.Categories;
    ViewData["Title"] = "Event Details";
}
<div class="row g-4">
    <div class="col-lg-8">
        @if (!string.IsNullOrWhiteSpace(Model.BannerImagePath)) { <img src="@Model.BannerImagePath" class="img-fluid rounded-4 mb-4 event-detail-banner" alt="Event banner" /> }
        <span class="badge text-bg-primary mb-2">@Model.EventType</span>
        <h1 class="display-6 fw-bold">@Model.EventName</h1>
        <p class="lead">@Model.Description</p>
        <p><strong>Date:</strong> @Model.EventDate.ToString("dddd, dd MMMM yyyy")</p>
        <p><strong>Venue:</strong> @Model.Venue, @Model.City, @Model.Province</p>
        <p><strong>Time:</strong> @Model.StartTime – @Model.EndTime</p>
        <h2 class="h4 mt-4">Available categories</h2>
        @if (!categories.Any()) { <div class="alert alert-info">No categories have been added yet.</div> }
        else
        {
            <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Distance</th><th>Age</th><th>Gender</th><th>Fee</th><th>Start</th><th></th></tr></thead><tbody>
            @foreach (var category in categories)
            {
                <tr><td>@category.Distance km</td><td>@category.AgeFrom–@category.AgeTo</td><td>@category.Gender</td><td>R @category.EntryFee.ToString("N2")</td><td>@category.StartTime</td><td><form asp-action="Enrol" method="post"><input type="hidden" name="eventId" value="@Model.EventID" /><input type="hidden" name="eventCategoryId" value="@category.EventCategoryID" /><button class="btn btn-sm btn-primary" type="submit">Enrol</button></form></td></tr>
            }
            </tbody></table></div>
        }
    </div>
</div>
<a asp-action="Events" class="btn btn-outline-secondary mt-3">Back to events</a>

@model RaceDay.Web.Models.ProfileViewModels
@{
    ViewData["Title"] = "My Profile";
}
<div class="row justify-content-center"><div class="col-lg-8">
    <div class="card"><div class="card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
            {
                <img src="@Model.ProfileImagePath" class="profile-photo" alt="Profile picture" />
            }
            else
            {
                <div class="profile-placeholder"><span>@Model.Name.FirstOrDefault()</span></div>
            }
            <div><h1 class="h3 mb-1">@Model.Name @Model.Surname</h1><p class="text-muted mb-0">@Model.Email</p></div>
        </div>
        <dl class="row">
            <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.Phone</dd>
            <dt class="col-sm-4">City</dt><dd class="col-sm-8">@Model.City</dd>
            <dt class="col-sm-4">Province</dt><dd class="col-sm-8">@Model.Province</dd>
            <dt class="col-sm-4">Date of birth</dt><dd class="col-sm-8">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
        </dl>
        @if (Model.Role == "Participant")
        {
            <a asp-action="Edit" class="btn btn-primary">Edit profile</a>
        }
    </div></div>
</div></div>

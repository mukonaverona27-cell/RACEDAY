@model RaceDay.Web.Models.EventCategoryViewModels
@{
    ViewData["Title"] = "Add Category";
}
<div class="row justify-content-center"><div class="col-lg-6">
    <div class="card"><div class="card-body p-4">
        <h1 class="h3 mb-4">Add event category</h1>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="EventID" type="hidden" />
            <div class="mb-3"><label asp-for="Distance" class="form-label">Distance (km)</label><input asp-for="Distance" class="form-control" /></div>
            <div class="row"><div class="col"><label asp-for="AgeFrom" class="form-label">Minimum age</label><input asp-for="AgeFrom" class="form-control" /></div><div class="col"><label asp-for="AgeTo" class="form-label">Maximum age</label><input asp-for="AgeTo" class="form-control" /></div></div>
            <div class="mb-3 mt-3"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select"><option>All</option><option>Male</option><option>Female</option></select></div>
            <div class="mb-3"><label asp-for="EntryFee" class="form-label">Entry fee (R)</label><input asp-for="EntryFee" class="form-control" /></div>
            <div class="mb-3"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" type="time" class="form-control" /></div>
            <button type="submit" class="btn btn-primary">Save category</button>
            <a asp-action="Index" asp-route-eventId="@Model.EventID" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@model RaceDay.Web.Models.EventViewModels
@{
    ViewData["Title"] = "Create event";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm"><div class="card-body p-4">
            <h1 class="h3 mb-4">Create a sporting event</h1>
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control" /><span asp-validation-for="EventName" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option value="">Select type</option><option>Road Race</option><option>Trail Run</option><option>Walking</option><option>Cycling</option><option>Fun Run</option></select></div>
                    <div class="col-md-6"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Venue" class="form-label"></label><input asp-for="Venue" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control" /></div>
                    <div class="col-md-3"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" type="time" class="form-control" /></div>
                    <div class="col-md-3"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" type="time" class="form-control" /></div>
                </div>
                <div class="mt-3"><label class="form-label">Event banner (JPG, PNG or WEBP; max 4 MB)</label><input type="file" name="bannerImage" class="form-control" accept=".jpg,.jpeg,.png,.webp" /></div>
                @if (!string.IsNullOrWhiteSpace(Model.BannerImagePath)) { <img src="@Model.BannerImagePath" class="img-fluid rounded mt-3 event-banner-preview" alt="Current event banner" /> }
                <input asp-for="BannerImagePath" type="hidden" />
                <button type="submit" class="btn btn-primary mt-4">Save event</button>
                <a asp-action="Index" class="btn btn-outline-secondary mt-4">Cancel</a>
            </form>
        </div></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

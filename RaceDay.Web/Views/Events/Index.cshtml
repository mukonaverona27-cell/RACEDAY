@model List<RaceDay.Web.Models.EventViewModels>
@{
    ViewData["Title"] = "My Events";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h2">My Events</h1><p class="text-muted">Create and maintain your sporting events.</p></div>
    <a asp-action="Create" class="btn btn-primary">Create event</a>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No events found for your organiser account.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Event</th><th>Date</th><th>Venue</th><th>Type</th><th>Manage</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventName</td><td>@item.EventDate.ToString("dd MMM yyyy")</td><td>@item.Venue, @item.City</td><td>@item.EventType</td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.EventID" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@item.EventID" class="btn btn-sm btn-outline-secondary">Categories</a>
                        <form asp-action="Delete" asp-route-id="@item.EventID" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

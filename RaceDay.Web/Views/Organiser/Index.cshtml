@model List<RaceDay.Web.Models.EventViewModels>
@{
    ViewData["Title"] = "Organiser Dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div><h1 class="h2 mb-1">Organiser Dashboard</h1><p class="text-muted mb-0">Manage your sporting events.</p></div>
    <a asp-controller="Events" asp-action="Create" class="btn btn-primary">Create event</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6"><div class="stat-card"><span class="text-muted">Events in the system</span><div class="display-6 fw-bold">@ViewBag.EventCount</div></div></div>
    <div class="col-sm-6"><div class="stat-card"><span class="text-muted">Your event tools</span><div class="h4 mt-2 mb-0">Events · Categories · Enrolments · Results</div></div></div>
</div>
<h2 class="h4 mb-3">Your events</h2>
@if (!Model.Any())
{
    <div class="alert alert-info">You have not created any events yet. Select Create event to get started.</div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(item.BannerImagePath)) { <img src="@item.BannerImagePath" class="card-img-top event-banner" alt="Event banner" /> }
                    <div class="card-body">
                        <h3 class="h5">@item.EventName</h3>
                        <p class="text-muted">@item.EventType · @item.EventDate.ToString("dd MMM yyyy")</p>
                        <p>@item.Venue, @item.City</p>
                        <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@item.EventID" class="btn btn-sm btn-outline-primary">Categories</a>
                        <a asp-controller="Enrolments" asp-action="Index" asp-route-eventId="@item.EventID" class="btn btn-sm btn-outline-secondary">Enrolments</a>
                        <a asp-controller="Results" asp-action="Index" asp-route-eventId="@item.EventID" class="btn btn-sm btn-outline-success">Results</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

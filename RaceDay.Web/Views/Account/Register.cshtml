@model RaceDay.Web.Models.RegisterViewModels
@{
    ViewData["Title"] = "Register";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 text-center mb-4">Create your RaceDay account</h1>
                <form asp-controller="Account" asp-action="Register" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label">Account type</label>
                            <select asp-for="Role" class="form-select">
                                <option value="Participant">Participant</option>
                                <option value="Organiser">Organiser</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Name / contact name</label>
                            <input asp-for="Name" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Surname" class="form-label"></label>
                            <input asp-for="Surname" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OrganizationName" class="form-label">Organisation name (organisers)</label>
                            <input asp-for="OrganizationName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IDNumber" class="form-label">ID number (participants)</label>
                            <input asp-for="IDNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label">Date of birth (participants)</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <input asp-for="Gender" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Province" class="form-label"></label>
                            <input asp-for="Province" class="form-control" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-4">Create account</button>
                </form>
                <p class="text-center mt-3 mb-0">Already registered? <a asp-controller="Account" asp-action="Login">Log in</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
